# Homebrew formula template; scripts/render-packaging.sh fills the @...@ fields.
class Nulix < Formula
  desc "GPU terminal with panes, blocks and persistent sessions"
  homepage "https://github.com/Tarqui-Mamani-Yimy/proySO1"
  license "MIT"

  depends_on "shellux"

  on_macos do
    depends_on arch: :arm64
    on_arm do
      url "https://github.com/Tarqui-Mamani-Yimy/proySO1/releases/download/v@VERSION@/nulix-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@NULIX_DARWIN_SHA256@"
    end
  end

  on_linux do
    depends_on arch: :x86_64
    on_intel do
      url "https://github.com/Tarqui-Mamani-Yimy/proySO1/releases/download/v@VERSION@/nulix-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@NULIX_LINUX_SHA256@"
    end
  end

  def install
    bin.install "bin/nulix", "bin/nulix-server", "bin/nulixctl"
    pkgshare.install "nulix.conf.example"
  end

  test do
    assert_match "Usage: nulixctl", shell_output("#{bin}/nulixctl --help 2>&1")
  end
end
